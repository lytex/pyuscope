{
    "motion": {
        "hal": "grbl-ser",
        // No homing on startup
        "limit_switches": false,
        "grbl": {
            "port": "/dev/serial/by-id/usb-1a86_USB_Serial-if00-port0",
        },
        "soft_limits": {
            "xmin": -300.0, "xmax": 300.0,
            "ymin": -180.0, "ymax": 180.0,
        },
    },
    "imager": {
        "source": "gst-v4l2src",
        // Camera only outputs MJPEG
        "source_mjpeg": true,
        "source_properties": {
            "device": "/dev/video0",
        },
        "width": 3840,
        "height": 2160,
        "um_per_pixel_raw_1x": 5.0,
    },
    "optics": {
        "um_per_pixel_raw_1x": 5.0,
    },
    "systems": [
        {
            "camera_sn": null,
            "objectives_db": [
                "vendor: Olympus, model: NeoSPlan 20X",
            ],
        },
    ],
}
